{
  "name": "norideck",
  "private": true,
  "version": "0.1.3",
  "description": "NoriDeck — TypeScript 카트리지(.nori)를 실행하는 DS 스타일 콘솔(에뮬레이터). 콘솔은 게임을 모른다.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "sdk",
    "cli",
    "create-nori",
    "runtime",
    "desktop",
    "carts/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w runtime",
    "dev:desktop": "npm run dev -w desktop",
    "build": "npm run build -w runtime",
    "build:sdk": "npm run build -w sdk",
    "build:cli": "npm run build -w cli",
    "build:desktop": "npm run build -w runtime && npm run package -w desktop",
    "install:linux": "npm run install:linux -w desktop",
    "start:desktop": "npm run build -w runtime && npm run start -w desktop",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.0"
  }
}
